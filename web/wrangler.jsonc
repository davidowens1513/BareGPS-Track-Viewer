{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baregps-track-viewer",
  "account_id": "047e0dac35a2d54dc205b85d1d83ed76",
  "compatibility_date": "2026-11-20",
  "main": "worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "appsbyonzy.dev/*",
      "zone_name": "appsbyonzy.dev"
    }
  ]
}
